<Window x:Class="Do_Re_Mi_Lyrics.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:Do_Re_Mi_Lyrics.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance viewModels:AboutWindowViewModel}"
        Title="About..." Height="600" Width="800" MinWidth="600" MinHeight="600" WindowStyle="ToolWindow"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Background="#FFEAEAEA">
    <Window.Resources>
        <Style x:Key="PageButton" TargetType="Button">
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10, 5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="#FFD5EED5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="5*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="160" />
            <RowDefinition />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>
        <Image Grid.Column="1" HorizontalAlignment="Left" Height="100" VerticalAlignment="Center" Width="100"
               Source="/Images/DO-RE-Mi-icon.png" />
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
            <TextBlock Text="{Binding NameVersion, FallbackValue=Do-Re-Mi Lyrics v1.0.0}" HorizontalAlignment="Center"
                       FontFamily="Calibri" FontWeight="Bold" FontSize="32" />
            <TextBlock Text="Enhanced Lyrics Maker" HorizontalAlignment="Center" FontFamily="Calibri" FontSize="14" />
            <TextBlock Text="© 2022-2026 Łukasz 'Woo-Cash' Przestrzelski" HorizontalAlignment="Center"
                       FontFamily="Calibri"
                       FontSize="14" />
            <TextBlock Text="https://github.com/blueberry-bytes/do-re-mi-lyrics" HorizontalAlignment="Center"
                       FontFamily="Calibri" FontSize="14" Cursor="Hand" Foreground="#FF001BFF"
                       MouseDown="Url_MouseDown" />
            <TextBlock Text="lukasz.przestrzelski@gmail.com" HorizontalAlignment="Center" FontFamily="Calibri"
                       FontSize="14" Cursor="Hand" Foreground="#FF001BFF" MouseDown="TextBlock_MouseDown" />
        </StackPanel>
        <Border Grid.Row="1" Grid.ColumnSpan="2" Grid.Column="0" Margin="20, 5" Background="White" BorderThickness="0"
                ClipToBounds="True">
            <Border Background="Transparent" BorderBrush="Black" BorderThickness="1" Margin="-1">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="5" />
                </Border.Effect>
                <WebBrowser x:Name="WebBrowser" Margin="5" />
            </Border>
        </Border>
        <StackPanel HorizontalAlignment="Left" Margin="20,0,0,20" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                    VerticalAlignment="Bottom" Orientation="Horizontal">
            <Button Content="Help" Style="{StaticResource PageButton}" Tag="{Binding IsHelpShown}"
                    Click="HelpClick" />
            <Button Content="License" Style="{StaticResource PageButton}" Tag="{Binding IsLicenseShown}"
                    Click="LicenseClick" />
            <Button Content="Changelog" Style="{StaticResource PageButton}" Tag="{Binding IsChangelogShown}"
                    Margin="0" Click="ChangelogClick" />
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" Margin="0,0,20,20" Grid.Row="2" Grid.Column="1"
                    VerticalAlignment="Bottom" Orientation="Horizontal">
            <Button Content="Open log folder" Margin="0,0,20,0" FontSize="14" Padding="10, 5"
                    Click="OpenLogFolderClick" />
            <Button Content="Close" FontSize="14" Padding="10, 5" Click="CloseClick" />
        </StackPanel>
    </Grid>
</Window>